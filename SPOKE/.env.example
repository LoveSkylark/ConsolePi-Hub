# Copy to .env and adjust for this spoke.

# Select which hub profile this spoke should use.
# Valid values: trusted or untrusted
SPOKE_PROFILE=untrusted

# Hub endpoint settings
HUB_ENDPOINT=change-me.example.com
HUB_PORT=51820

# Tunnel addressing used by this one profile.
# Set these to trusted values OR untrusted values depending on SPOKE_PROFILE.
HUB_TUNNEL_IP=10.99.98.1
SPOKE_TUNNEL_IP=10.99.98.11

# Trusted quick reference (if SPOKE_PROFILE=trusted):
# HUB_PORT=51821
# HUB_TUNNEL_IP=10.99.99.1
# SPOKE_TUNNEL_IP=10.99.99.11

# Key placeholders used in rendered example templates.
SPOKE_PRIVATE_KEY=CHANGE_ME_SPOKE_PRIVATE_KEY
HUB_PUBLIC_KEY=CHANGE_ME_HUB_PUBLIC_KEY

# Keepalive for NAT traversal
PERSISTENT_KEEPALIVE=25
