# Copy to .env and adjust for this spoke.

# HUB profile selector.
# Valid values: trusted or untrusted.
# Port is derived automatically: trusted -> 51821, untrusted -> 51820.
HUB_PROFILE=untrusted

# Hub endpoint settings.
HUB_ENDPOINT=change-me.example.com

# WireGuard addressing for this spoke.
# WG_SUBNET must be a /24. HUB tunnel IP is derived as host .1.
# WG_SPOKE is the peer slot index, and spoke IP is derived as host .(10 + slot).
# Example: WG_SPOKE=1 -> .11, WG_SPOKE=2 -> .12, WG_SPOKE=3 -> .13.
WG_SUBNET=10.99.98.0/24
WG_SPOKE=1

# Trusted quick reference:
# HUB_PROFILE=trusted
# WG_SUBNET=10.99.99.0/24
# WG_SPOKE=1

# Spoke private key is auto-generated on first full deploy.
# Use ./deploy-spoke.sh --new-key to rotate it later.
# Use ./deploy-spoke.sh --get-key to print the current public key.
HUB_PUBLIC_KEY=CHANGE_ME_HUB_PUBLIC_KEY


