# macOS
.DS_Store

# Local environment files
HUB/.env
SPOKE/.env
SPOKE-Debian/.env

# Rendered or active WireGuard configs
HUB/wireguard/trusted/config/wg_confs/wg-trusted.conf
HUB/wireguard/untrusted/config/wg_confs/wg-untrusted.conf
HUB/wireguard/**/wg-*.privatekey
HUB/wireguard/**/wg-*.publickey
HUB/wireguard/profiles/profile-*.conf.example
SPOKE/rendered/
SPOKE-Debian/rendered/

# Peer registration helper outputs
HUB/wireguard/profiles/*.conf.snippet

# Runtime ConsolePi data
HUB/consolepi/data/
HUB/consolepi/runtime/
HUB/consolepi/ssh/system-users/

# Local backups and temporary files
*.bak
*.bak.*
*.tmp
*.swp

# Python cache
__pycache__/
*.pyc