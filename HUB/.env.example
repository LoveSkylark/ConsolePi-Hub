# Copy this to .env and edit values before first run.

# External UDP ports exposed by the host firewall/FortiGate VIPs.
WG_TRUSTED_PORT=51821
WG_UNTRUSTED_PORT=51820

# External SSH management port for ConsolePi container (host side).
MGMT_SSH_PORT=2222

# Comma-separated source CIDRs allowed to access external management SSH.
# Keep this tight (example: 203.0.113.10/32,198.51.100.0/24).
MGMT_ALLOWED_DIRECT_SSH=203.0.113.10/32

# VPN profile networks (change these to re-address trusted/untrusted pools).
# Each peer slot index maps to host .(10 + index) inside the subnet.
# Example: index 1 => .11, index 2 => .12, index 3 => .13
# Add more peers by appending sequential key slots (for example _4, _5, _6).
# Keep trusted/untrusted slot numbering aligned with your spoke inventory.
# HUB interface IP is auto-derived as host .1 from each /24 subnet.
WG_TRUSTED_SUBNET=10.99.99.0/24
WG_TRUSTED_PEER_KEY_1=
WG_TRUSTED_PEER_KEY_2=
WG_TRUSTED_PEER_KEY_3=

WG_UNTRUSTED_SUBNET=10.99.98.0/24
WG_UNTRUSTED_PEER_KEY_1=
WG_UNTRUSTED_PEER_KEY_2=
WG_UNTRUSTED_PEER_KEY_3=


# SSH auth policy for ConsolePi container.
# Keep password auth disabled unless you explicitly need it.
CONSOLEPI_SSH_PASSWORD_AUTH=false

# Comma-separated SSH users allowed to login.
# Example: consolepi,opsadmin,nocadmin
CONSOLEPI_ALLOW_USERS=consolepi

# Users file mounted inside container for additional users and password hashes.
# File format (one per line): username:mode:password_hash
# mode is 'menu' or 'shell'.
# Backward compatible format username:password_hash is also accepted as shell mode.
# Example hash generation: openssl passwd -6 'StrongPasswordHere'
CONSOLEPI_USERS_FILE=/ssh/users.conf

# Grant sudo group membership to users in CONSOLEPI_ALLOW_USERS and users.conf.
# Keep true if users need python-based consolepi-menu functionality.
CONSOLEPI_GRANT_SUDO=true

# Behavior after a forced menu session exits for users in users.conf mode=menu.
# logout (default) closes SSH session; shell drops into interactive shell.
CONSOLEPI_MENU_EXIT_ACTION=logout

# For mode=menu users, allow passwordless sudo so consolepi-menu works in
# non-interactive forced-command paths.
CONSOLEPI_MENU_NOPASSWD_SUDO=true

# Comma-separated hostname prefixes that should be promoted to main menu when
# running deploy-hub.sh --get-hosts. Matching is case-insensitive.
# Example: dc1-,dc2-,core-
HOSTS_MAIN_MENU_PREFIXES=dc1-,dc2-
