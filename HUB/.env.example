# Copy this to .env and edit values before first run.

# External SSH management port for ConsolePi container (host side).
MGMT_SSH_PORT=2222

# Comma-separated source CIDRs allowed to access external management SSH.
# Keep this tight (example: 203.0.113.10/32,198.51.100.0/24).
MGMT_ALLOWED_DIRECT_SSH=203.0.113.10/32

# VPN profile networks (change these to re-address trusted/untrusted pools).
# Each peer slot index maps to host .(10 + index) inside the subnet.
# Example: index 1 => .11, index 2 => .12, index 3 => .13
# Add more peers by appending sequential key slots (for example _4, _5, _6).
# Keep trusted/untrusted slot numbering aligned with your spoke inventory.
# HUB interface IP is auto-derived as host .1 from each /24 subnet.
WG_TRUSTED_SUBNET=10.99.99.0/24
WG_TRUSTED_PEER_KEY_1=
WG_TRUSTED_PEER_KEY_2=
WG_TRUSTED_PEER_KEY_3=

WG_UNTRUSTED_SUBNET=10.99.98.0/24
WG_UNTRUSTED_PEER_KEY_1=
WG_UNTRUSTED_PEER_KEY_2=
WG_UNTRUSTED_PEER_KEY_3=


