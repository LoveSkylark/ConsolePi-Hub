# Copy this to .env and edit values before first run.

# Runtime identity for linuxserver containers.
PUID=1000
PGID=1000
TZ=UTC

# External UDP ports exposed by the host firewall/FortiGate VIPs.
WG_TRUSTED_PORT=51821
WG_UNTRUSTED_PORT=51820

# VPN profile networks (change these to re-address trusted/untrusted pools).
WG_TRUSTED_SUBNET=10.99.99.0/24
WG_TRUSTED_HUB_IP=10.99.99.1
WG_TRUSTED_PEER_IPS=10.99.99.11,10.99.99.12,10.99.99.13

WG_UNTRUSTED_SUBNET=10.99.98.0/24
WG_UNTRUSTED_HUB_IP=10.99.98.1
WG_UNTRUSTED_PEER_IPS=10.99.98.11,10.99.98.12,10.99.98.13

# Interface policy for profile-based access.
# Trusted profile interface can access ConsolePi SSH; untrusted is blocked.
TRUSTED_SSH_INTERFACE=wg-trusted
UNTRUSTED_SSH_INTERFACE=wg-untrusted
