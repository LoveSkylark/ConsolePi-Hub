# Copy to wg0.conf and replace placeholders.
# This is a server-style WireGuard config run by wg-quick inside the container.

[Interface]
Address = 10.99.99.1/24
ListenPort = 51820
PrivateKey = <HUB_PRIVATE_KEY>
SaveConfig = false

# Keep spoke-to-spoke isolation explicit, even if forwarding is off elsewhere.
PostUp = iptables -A FORWARD -i wg0 -o wg0 -j DROP
PostDown = iptables -D FORWARD -i wg0 -o wg0 -j DROP

[Peer]
# Spoke 1
PublicKey = <SPOKE1_PUBLIC_KEY>
AllowedIPs = 10.99.99.11/32
PersistentKeepalive = 25

[Peer]
# Spoke 2
PublicKey = <SPOKE2_PUBLIC_KEY>
AllowedIPs = 10.99.99.12/32
PersistentKeepalive = 25
